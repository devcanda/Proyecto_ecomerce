// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum UserRole {
  ADMIN
  MODERATOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Define que campos extra piden los productos de una categoria
enum VariantType {
  NONE // sin tallas (tecnologia, articulos varios)
  FOOTWEAR // calzado: tallas COL (38, 38.5, ...)
  CLOTHING // ropa (general): tallas XS, S, M, L, ...
  CLOTHING_MEN // (antiguo) ropa de hombre: ahora es CLOTHING + genero MEN
  CLOTHING_WOMEN // (antiguo) ropa de mujer: ahora es CLOTHING + genero WOMEN
}

// Para quien es el producto (null = no aplica, ej. tecnologia)
enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum PaymentMethod {
  CARD
  TRANSFER
  WALLET
  CASH_ON_DELIVERY
}

// ==================== MODELS ====================

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String
  phone     String?
  avatar    String?
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  addresses Address[]
  orders    Order[]

  @@map("users")
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  icon        String?
  variantType VariantType @default(NONE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  // Imagen de la guia de tallas de la marca (se muestra en sus productos de calzado/ropa)
  sizeGuide String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  models   ProductModel[]

  @@map("brands")
}

// Modelo de un producto dentro de una marca (ej. Nike -> Air Max 90, Logitech -> G Pro X)
model ProductModel {
  id        String   @id @default(cuid())
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([brandId, slug])
  @@index([brandId])
  @@map("product_models")
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2)
  stock        Int      @default(0)
  images       String[]
  specs        Json?
  isNew        Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  // Tipo de talla de las variantes del producto (NONE = sin talla o producto simple)
  sizeType VariantType @default(NONE)
  // Hombre, mujer o unisex (null = no aplica)
  gender   Gender?

  modelId String?
  model   ProductModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([modelId])
  @@index([slug])
  @@map("products")
}

model Address {
  id        String   @id @default(cuid())
  label     String
  name      String
  phone     String
  address   String
  city      String
  state     String
  zipCode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  shipping        Decimal     @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  paymentMethod   String
  stripeSessionId String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  items OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@map("orders")
}

// Combinacion de talla y/o color de un producto, con su propio stock y precio opcional
model ProductVariant {
  id        String   @id @default(cuid())
  size      String?
  color     String?
  // Si es null se usa el precio del producto
  price     Decimal? @db.Decimal(10, 2)
  stock     Int      @default(0)
  // Fotos del color: la primera es la portada, las demas otros angulos (iguales en todas sus tallas)
  images    String[] @default([])
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model OrderItem {
  id       String  @id @default(cuid())
  name     String
  price    Decimal @db.Decimal(10, 2)
  quantity Int
  total    Decimal @db.Decimal(10, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Talla/color comprados (el texto queda guardado aunque la variante se elimine despues)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel String?

  @@index([orderId])
  @@map("order_items")
}
